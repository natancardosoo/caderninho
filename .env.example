# Credenciais da Pluggy (dashboard.pluggy.ai → Applications). Opcional: sem elas o app funciona só com lançamentos manuais.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# hora da sincronização diária (0-23)
PLUGGY_SYNC_HOUR=18
# conectores exibidos no widget (200 = MeuPluggy)
PLUGGY_CONNECTOR_IDS=200
# porta do servidor (padrão 4320)
# PORT=4320
